{
  "version": "1.0",
  "pageName": "home",
  "metaDescription": "Live runtime demo: sign in and subscribe, then watch every part of the page and every tab follow.",
  "grid": { "columns": 12, "gap": 16 },
  "globalStyles": { "cssVariables": { "brand": "#2563eb" } },
  "components": [
    {
      "instanceId": "nav-1",
      "pluginId": "navbar-component-plugin",
      "componentId": "Navbar",
      "displayOrder": 0,
      "position": { "x": 0, "y": 0 },
      "size": { "width": 0, "height": 0 },
      "props": {
        "brandText": "VSD Live Demo",
        "navItems": "[{\"label\":\"Home\",\"href\":\"/\"},{\"label\":\"About\",\"href\":\"/about\"}]"
      },
      "styles": { "backgroundColor": "#111827", "color": "#ffffff" }
    },
    {
      "instanceId": "main-1",
      "pluginId": "container-layout-plugin",
      "componentId": "Container",
      "displayOrder": 1,
      "position": { "x": 0, "y": 0 },
      "size": { "width": 0, "height": 0 },
      "props": { "layoutMode": "flex-column", "heightMode": "wrap", "padding": "32px", "maxWidth": "720px", "centerContent": true },
      "styles": {},
      "children": [
        {
          "instanceId": "title-1",
          "pluginId": "label-component-plugin",
          "componentId": "Label",
          "position": { "x": 0, "y": 0 },
          "size": { "width": 0, "height": 0 },
          "props": { "text": "One session, many plugins", "variant": "h1" },
          "styles": {}
        },
        {
          "instanceId": "intro-1",
          "pluginId": "label-component-plugin",
          "componentId": "Label",
          "position": { "x": 0, "y": 0 },
          "size": { "width": 0, "height": 0 },
          "props": { "text": "Sign in below and the navbar changes. Subscribe and the form remembers it, here, on the About page and in every other tab.", "variant": "p" },
          "styles": {}
        },
        {
          "instanceId": "login-1",
          "pluginId": "auth-component-plugin",
          "componentId": "LoginForm",
          "position": { "x": 0, "y": 0 },
          "size": { "width": 0, "height": 0 },
          "props": { "title": "Sign in", "subtitle": "Try demo@example.com / demo-pass", "showForgotPassword": false, "showRememberMe": false },
          "styles": {}
        },
        {
          "instanceId": "logout-1",
          "pluginId": "auth-component-plugin",
          "componentId": "LogoutButton",
          "position": { "x": 0, "y": 0 },
          "size": { "width": 0, "height": 0 },
          "props": { "text": "Sign out" },
          "styles": {}
        },
        {
          "instanceId": "news-1",
          "pluginId": "newsletter-form-plugin",
          "componentId": "NewsletterForm",
          "position": { "x": 0, "y": 0 },
          "size": { "width": 0, "height": 0 },
          "props": { "title": "Newsletter", "subtitle": "Get the next release note.", "successMessage": "You are subscribed. Thank you!" },
          "styles": {}
        }
      ]
    }
  ]
}
